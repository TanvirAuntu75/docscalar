# ===================================================
# DocScalar Production .gitignore
# ===================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock

# Build output
dist/
dist-ssr/
*.local

# Agent memory (auto-generated)
.agents/repo_map.md

# Scratch / dev-only artifacts
scratch/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Environment variables & secrets
.env
.env.local
.env.*
backend/.jwt_secret
.jwt_secret
*.jwt_secret
*.pat
*.token
*.key
*.pem
mcp_config.json

# SQLite databases (DocScalar + legacy DocForge)
docscalar.db
docscalar.db-shm
docscalar.db-wal
docscalar.db-journal
docforge.db
docforge.db-shm
docforge.db-wal
docforge.db-journal

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Backend runtime directories
backend/uploads/
backend/output/
backend/test_output/
backend/models/

# Frontend model cache
public/models/

# Tauri desktop build artifacts
src-tauri/target/
src-tauri/binaries/
src-tauri/wix-bin/
src-tauri/*.exe
src-tauri/docforge-backend-*
src-tauri/docscalar-backend-*

# Archive bundles
*.zip

# Benchmarks heavy datasets
benchmarks/ARC-AGI/

# Legacy / deprecated
docforge-studio/

# OCR training data (heavy, stored separately)
training/datasets/
ocr_data/
